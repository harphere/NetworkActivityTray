<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>NetworkActivityTray</AssemblyName>
    <RootNamespace>NetworkActivityTray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <InformationalVersion>0.5.0</InformationalVersion>

    <Product>Network Activity Tray</Product>
    <Title>Network Activity Tray</Title>
    <Description>Windows tray send/receive activity indicator</Description>
    <Company>Network Activity Tray</Company>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PENetwork_W10_GUI_Colored.icl"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('PENetwork_W10_GUI_Colored.icl')" />
  </ItemGroup>
</Project>
